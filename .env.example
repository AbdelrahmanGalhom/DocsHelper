OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Use absolute paths to access cache from any directory
# Update these paths to match your installation directory
DOCSHELPER_CACHE_DIR=
DOCSHELPER_CHROMA_DIR=

DOCSHELPER_USER_AGENT=DocsHelper/0.1 (+https://example.local)
DOCSHELPER_TIMEOUT=20

# LangSmith Monitoring (Optional)
# Get API key from https://smith.langchain.com/
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=docshelper
